# Backend API origin (no trailing slash). Defaults to the hosted backend.
PUBLIC_API_BASE_URL=https://ajoguard.onrender.com

# Optional — enables the Google Identity Services (ID-token) sign-in button on
# /login. When unset, the login page falls back to the server-side redirect flow.
# Must match a Web "Authorized JavaScript origins" entry in Google Cloud Console.
# PUBLIC_GOOGLE_CLIENT_ID=

# Telegram bot username used for contribution ingestion and member notifications.
# With or without the leading "@". When empty, the dashboard shows a
# "channel not configured" state instead of a broken link.
# PUBLIC_TELEGRAM_BOT_HANDLE=AjoGuardBot